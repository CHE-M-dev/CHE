NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, used exclusively by the super admin's
# "create sub-admin" action to create auth users directly. Never expose
# this to the browser. Find it in Supabase dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL this app is deployed at (e.g. https://your-app.vercel.app).
# Used by the Telegram bot's "Open App" button — see README's Telegram section.
NEXT_PUBLIC_SITE_URL=

# Telegram bot integration (optional). Create a bot via @BotFather to get
# the token; the webhook secret is a random string you choose yourself and
# pass to setWebhook — see README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
